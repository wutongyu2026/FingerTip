{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "FingerTip 默认窗口能力集：外部链接 + Save As 对话框 + AppData 内写文件 + 基础窗口控制",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:default",
    "opener:default",
    "dialog:default",
    "fs:allow-write-file",
    "fs:allow-read-file",
    "fs:allow-mkdir",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DESKTOP/**" }
      ]
    }
  ]
}
